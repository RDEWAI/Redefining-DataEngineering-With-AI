{
  "description": "Library Assistant hooks: read-only query enforcement",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/enforce-readonly-queries.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
