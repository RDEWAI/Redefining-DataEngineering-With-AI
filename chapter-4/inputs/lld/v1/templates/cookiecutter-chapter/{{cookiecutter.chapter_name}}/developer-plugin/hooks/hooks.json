{
  "description": "Developer plugin hooks: post-write validation for DAGs and pipelines",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/validate-output-hook.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
