is_current: {{ table.is_current }}
{% endif %}
columns:
{% for col in table.columns %}
  - name: {{ col.name }}
    type: {{ col.type }}
    nullable: {{ col.nullable }}
    description: {{ col.description }}
{% if col.scd_type %}
    scd_type: {{ col.scd_type }}
{% endif %}
{% endfor %}
foreign_keys:
{% for fk in table.foreign_keys %}
  - column: {{ fk.column }}
    references: {{ fk.references }}
{% endfor %}
```

