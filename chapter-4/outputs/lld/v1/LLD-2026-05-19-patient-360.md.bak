    subgraph SilverDims["Silver -- Dimensions First (SCD Type 2, inline SE)"]
        SD1[transform_patients_silver]
        SD2[transform_organizations_silver]
        SD3[transform_providers_silver]
        SD4[transform_payers_silver]
    end

    subgraph SilverFacts["Silver -- Fact Tables (inline SE)"]
        SF1[transform_encounters_silver]
        SF2[transform_conditions_silver]
        SF3[transform_medications_silver]
        SF4[transform_observations_silver]
        SF5[transform_allergies_silver]
        SF6[transform_immunizations_silver]
