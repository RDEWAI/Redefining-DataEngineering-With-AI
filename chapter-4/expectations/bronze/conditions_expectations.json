[
  {
    "rule_name": "patient_fk_not_null",
    "column": "patient",
    "rule": "patient IS NOT NULL",
    "action_if_failed": "drop",
    "description": "Condition must be linked to a patient"
  },
  {
    "rule_name": "condition_code_not_null",
    "column": "code",
    "rule": "code IS NOT NULL",
    "action_if_failed": "drop",
    "description": "SNOMED condition code required"
  },
  {
    "rule_name": "stop_after_start",
    "column": "stop",
    "rule": "stop IS NULL OR stop >= start",
    "action_if_failed": "warn",
    "description": "Condition stop must be after or equal to start"
  }
]
