# Dockerfile for OpenHands GUI with PWI Integration
#
# This image extends the official OpenHands container with:
# - PWI custom tools (DuckDB, CSV, Metadata, Artifact, Validation)
# - PWI microagents (data_analyst, data_architect, mapping_engineer, etc.)
# - PWI skills (duckdb, drd_validation, dmd_validation, etc.)
#
# Build:
#   docker build -f Dockerfile.openhands -t pwi-openhands:latest .
#
# Run:
#   docker-compose -f docker-compose.openhands.yml up

FROM docker.all-hands.dev/all-hands-ai/openhands:0.54

# Set environment variables
ENV PYTHONPATH=/app:/workspace \
    PYTHONUNBUFFERED=1 \
    PWI_HOME=/app

# Switch to root for installation
USER root

# Create app directory
WORKDIR /app

# Install only PWI-specific dependencies (avoid overwriting OpenHands dependencies)
# The base image already has most of what we need - just add DuckDB
RUN pip install --no-cache-dir duckdb==1.1.3

# Copy PWI source code
COPY pwi/ /app/pwi/

# Copy OpenHands microagents and skills
COPY .openhands/ /app/.openhands/

# Install PWI as editable package
RUN pip install -e /app --no-deps || true

# Create scripts directory and copy entrypoint
RUN mkdir -p /app/scripts
COPY --chmod=755 scripts/openhands-entrypoint.sh /app/scripts/

# Create output directory and OpenHands state directory with proper permissions
RUN mkdir -p /workspace/output && chmod 777 /workspace/output && \
    mkdir -p /.openhands && chmod 777 /.openhands

# Set ownership for openhands user (uid 42420) on required directories
RUN chown -R 42420:42420 /app /workspace/output /.openhands

# Switch back to openhands user
USER openhands

# Keep working directory as /app for the OpenHands server (frontend build requires it)
WORKDIR /app

# Use custom entrypoint that registers PWI tools
ENTRYPOINT ["/app/scripts/openhands-entrypoint.sh"]

# Default command: call original entrypoint which will run uvicorn
CMD ["/app/entrypoint.sh", "uvicorn", "openhands.server.listen:app", "--host", "0.0.0.0", "--port", "3000"]
