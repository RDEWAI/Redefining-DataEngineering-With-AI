# Illustrative Airflow DAG factory — see airflow-dag-pattern.md.
# Generic placeholders: {project}.

import os
from datetime import datetime, timedelta
from airflow.decorators import dag, task_group
from airflow.providers.apache.spark.operators.spark_submit import SparkSubmitOperator

# Env-driven config locations. These MUST be set by the cookiecutter
# docker-compose.yml — never hardcode `airflow/configs` (relative) or
# `airflow/jobs` (relative). See pitfall in airflow-dag-pattern.md.
DEFAULT_CONFIGS_DIR = os.environ.get("AIRFLOW_CONFIGS_DIR", "/opt/airflow/configs")
DEFAULT_RUNNER_APP = os.environ.get("LAYER_RUNNER_APP", "/opt/airflow/jobs/run_local.py")

DEFAULT_ARGS = {
    "owner": "{project}",
    "retries": 2,
    "retry_delay": timedelta(minutes=5),
    "sla": timedelta(minutes=30),
    "depends_on_past": False,
}


def _spark_task(task_id: str, layer: str, target: str,
                application: str | None = None,
                configs_dir: str | None = None):
    """Build a SparkSubmitOperator pointing at a per-task entry script.

    `application` resolves from (in order): explicit arg → `<TYPE>_APP` env
    var (e.g. `BRONZE_RUNNER_APP`) → `LAYER_RUNNER_APP` → the
    /opt/airflow/jobs/run_local.py default. Per-task scripts live under
    `airflow/jobs/run_<task_type>.py` and are auto-generated by
    /developer-plugin:create-dag from the LLD §4.2 task inventory.
    """
    type_app = os.environ.get(f"{layer.upper()}_RUNNER_APP", DEFAULT_RUNNER_APP)
    return SparkSubmitOperator(
        task_id=task_id,
        application=application or type_app,
        application_args=[
            "--layer", layer,
            "--table", target,
            "--ds", "{{ ds }}",
            "--config-path", f"{(configs_dir or DEFAULT_CONFIGS_DIR)}/{target}.yml",
        ],
        conn_id="spark_default",
    )


def make_pipeline_dag(project: str, schedule: str,
                      bronze: list[str], silver: list[str], gold: list[str],
                      configs_dir: str | None = None):
    @dag(
        dag_id=f"{project}_{schedule.lstrip('@')}_v1",
        schedule=schedule,
        start_date=datetime(2026, 1, 1),
        catchup=False,
        default_args=DEFAULT_ARGS,
        tags=[project, "medallion"],
    )
    def pipeline():
        @task_group(group_id="bronze")
        def bronze_tg():
            for t in bronze:
                _spark_task(f"ingest_{t}", "bronze", t, configs_dir=configs_dir)

        @task_group(group_id="silver")
        def silver_tg():
            for t in silver:
                _spark_task(f"transform_{t}", "silver", t, configs_dir=configs_dir)

        @task_group(group_id="gold")
        def gold_tg():
            for t in gold:
                _spark_task(f"build_{t}", "gold", t, configs_dir=configs_dir)

        bronze_tg() >> silver_tg() >> gold_tg()

    return pipeline()
