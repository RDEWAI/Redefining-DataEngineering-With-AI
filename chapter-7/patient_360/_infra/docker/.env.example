# Copy to _infra/docker/.env (gitignored). Compose reads it automatically.

# --- Failure alerting (utils/alerting.py, DAG-ALERT-001) ---------------------
# keep (DEV default) | pagerduty | file | none. Overrides monitoring.alerting_sink.
ALERT_SINK=keep
# Keep: any value works in NOAUTH mode; kept explicit so PROD-style configs are identical.
KEEP_API_KEY=keep-dev-key
# PagerDuty Events API v2 integration key (32 chars). Only used when ALERT_SINK=pagerduty.
PAGERDUTY_ROUTING_KEY=

# --- rca-runner (sre-plugin/service) -----------------------------------------
# Where Keep's rca-on-incident workflow posts. host.docker.internal = the host-run runner.
RCA_WEBHOOK_URL=http://host.docker.internal:8090/webhook/keep
RCA_WEBHOOK_TOKEN=dev-token
# PagerDuty v3 webhook subscription secret + REST key for notes (PROD path only).
PAGERDUTY_WEBHOOK_SECRET=
PAGERDUTY_API_KEY=
PAGERDUTY_FROM_EMAIL=

# --- Marquez host ports (existing) -------------------------------------------
MARQUEZ_API_HOST_PORT=5001
MARQUEZ_ADMIN_HOST_PORT=5002
