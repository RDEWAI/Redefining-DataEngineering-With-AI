# patient_360 Airflow image (LLD §6.1 local_executor_mode = in-airflow-local[*]).
# Bakes JDK 17 + PySpark 4.0.0 + Delta + Spark Expectations into the worker
# image so SparkSubmitOperator can run with `--master local[2]` (no sidecar
# Spark cluster). Versions match the pins in inputs/code/v1/LIBRARIES.md.
FROM apache/airflow:3.2.1-python3.11

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
 && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-arm64

# Make /opt/patient_360 airflow-writable so the runtime can create
# ${PATIENT360_PROJECT_ROOT}/warehouse/{env}/ (Hive warehouse + embedded
# Derby metastore per LLD v1.15 §13 Decision 12 + §9.1). Without this,
# Derby fails with `Failed to create database '/opt/patient_360/warehouse/dev/metastore_db'`.
# Direct-edited 2026-05-21 pending an AC under STORY-01-007 + update-scaffold re-run.
RUN mkdir -p /opt/patient_360/warehouse \
 && chown -R airflow:root /opt/patient_360 \
 && chmod 775 /opt/patient_360

USER airflow
# spark-expectations>=2.10.0 is MANDATORY — earlier versions don't support
# the YAML rule format our DQ generator emits (see LIBRARIES.md note).
RUN pip install --no-cache-dir \
        "apache-airflow-providers-apache-spark==6.0.1" \
        "pyspark==4.0.2" \
        "delta-spark==4.0.0" \
        "spark-expectations>=2.10.0" \
        "pyyaml" \
        "duckdb"
