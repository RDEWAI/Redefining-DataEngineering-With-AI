{
  "$schema": "https://modelcontextprotocol.io/schema/config.json",
  "mcpServers": {
    "library-server": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/chapter-3",
        "python",
        "-m",
        "fastmcp",
        "run",
        "src/mcp_servers/library_server.py"
      ],
      "env": {
        "DB_PATH": "/absolute/path/to/chapter-3/data/duckdb/chapter3.db"
      }
    }
  }
}
