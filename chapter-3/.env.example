# =============================================================================
# Unified LLM Configuration (NEW - Phase 5.5)
# =============================================================================
# The UnifiedLLMClient uses the OpenAI SDK with custom base_url to support
# multiple providers (OpenRouter, Ollama, OpenAI) through a single interface.

# LLM Base URL - Required
# Choose one of the following:
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
#   OpenAI:     https://api.openai.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# LLM API Key - Required for OpenRouter/OpenAI, optional for Ollama
# For OpenRouter: Get your key at https://openrouter.ai/keys
# For OpenAI: Get your key at https://platform.openai.com/api-keys
# For Ollama: Leave empty or omit
LLM_API_KEY=your-api-key-here

# LLM Model - The model identifier to use
# OpenRouter models (with tool support):
#   - openai/gpt-4o-mini (recommended, fast & cheap)
#   - anthropic/claude-3-haiku-20240307
#   - mistralai/mistral-small-latest
# Ollama models:
#   - llama3.2
#   - mistral
# OpenAI models:
#   - gpt-4o-mini
#   - gpt-4o
LLM_MODEL=openai/gpt-4o-mini

# Enable usage tracking (token counts)
# Note: Only OpenRouter returns detailed usage metrics
LLM_ENABLE_USAGE_TRACKING=true

# =============================================================================
# Legacy Configuration (DEPRECATED - will be removed in Phase 7)
# =============================================================================
# These variables are deprecated. Use the unified configuration above instead.
# OPENROUTER_API_KEY - Use LLM_API_KEY instead
# LLM_PROVIDER - Use LLM_BASE_URL to select provider
# OLLAMA_HOST - Use LLM_BASE_URL instead

# Database Configuration
DB_PATH=data/duckdb/chapter3.db

# Logging
LOG_LEVEL=INFO
