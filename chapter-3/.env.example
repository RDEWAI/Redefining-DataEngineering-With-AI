# LLM Provider Configuration
OPENROUTER_API_KEY=your-api-key-here
LLM_PROVIDER=openrouter

# Models that support tool/function calling on OpenRouter:
# IMPORTANT: Not all models support tools - these are verified to work:
LLM_MODEL=openai/gpt-4o-mini
# Alternative models with tool support:
# LLM_MODEL=anthropic/claude-3-haiku-20240307
# LLM_MODEL=mistralai/mistral-small-latest

# Alternative: Local Ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# Database Configuration
DB_PATH=data/duckdb/chapter3.db

# Logging
LOG_LEVEL=INFO
