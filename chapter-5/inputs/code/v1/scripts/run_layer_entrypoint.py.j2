{# Jinja template for per-task entry-script wrappers under airflow/jobs/. #}
{# Rendered by /developer-plugin:create-dag (and create-ingestion) once per #}
{# distinct task type listed in LLD §4.2 task inventory. #}
{# #}
{# Variables: #}
{#   project              — cookiecutter project name (e.g. patient_360) #}
{#   task_type            — short id, e.g. "bronze_ingestion", "bronze_recon" #}
{#   runner_module        — dotted module path the wrapper imports, #}
{#                          e.g. "patient_360.bronze.ingestion_runner" #}
{#   entry_function       — function name to invoke on the runner module, #}
{#                          typically "main" — receives parsed argv. #}
{#   argv_spec            — list[dict] from LLD §5 task signature: #}
{#                          [{"name": "--config-path", "required": true,  #}
{#                            "help": "Per-table YAML config path"}, ...] #}
{# #}
{# The rendered file is a 15-25 line shim that argv-parses, imports the #}
{# runner module dynamically (so the wrapper survives runner refactors), #}
{# and dispatches to the entry function. SparkSubmitOperator points at #}
{# this file via `application=os.environ["{{ task_type | upper }}_RUNNER_APP"]`. #}
"""Spark-submit entry wrapper for {{ task_type }} tasks.

Auto-generated by /developer-plugin:create-dag from LLD §4.2 task inventory.
Do not hand-edit — re-run create-dag to regenerate.

Lifecycle:
  Airflow → SparkSubmitOperator(application=this_file)
        → spark-submit run_{{ task_type }}.py --config-path … --ds …
        → {{ runner_module }}.{{ entry_function }}(args)
"""

from __future__ import annotations

import argparse
import importlib
import logging
import sys

logger = logging.getLogger(__name__)


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    p = argparse.ArgumentParser(description="{{ task_type }} entry wrapper")
{%- for arg in argv_spec %}
    p.add_argument(
        "{{ arg.name }}",
        {% if arg.required %}required=True,{% endif %}
        help="{{ arg.help | replace('"', '\\"') }}",
    )
{%- endfor %}
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    runner = importlib.import_module("{{ runner_module }}")
    if not hasattr(runner, "{{ entry_function }}"):
        raise AttributeError(
            "{{ runner_module }} has no `{{ entry_function }}` — regenerate "
            "this wrapper after the runner contract changes."
        )
    return getattr(runner, "{{ entry_function }}")(args)


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
    sys.exit(main(sys.argv[1:]))
