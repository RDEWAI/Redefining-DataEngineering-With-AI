flowchart LR
    subgraph planning["Planning Phase"]
        direction TB
        BA["BA<br/><i>Business Analyst</i>"] -->|produces| DRD["DRD<br/><i>Data Requirements<br/>Document</i>"]
        ARCH["Architect<br/><i>Data Architect</i>"] -->|produces| HLD["HLD<br/><i>High-Level Design</i>"]
        DMR["DM<br/><i>Data Modeler</i>"] -->|produces| DMS["DMS<br/><i>Data Model<br/>Specification</i>"]
    end

    subgraph eng["Engineering Phase"]
        direction TB
        TA["TA / MA<br/><i>Mapping Analyst</i>"] -->|produces| STM["STM<br/><i>Source-to-Target<br/>Mapping</i>"]
        DQE["DQE<br/><i>DQ Engineer</i>"] -->|produces| DQS["DQS<br/><i>Data Quality<br/>Specification</i>"]
        TL["TL<br/><i>Technical Lead</i>"] -->|produces| LLD["LLD<br/><i>Low-Level Design</i>"]
    end

    subgraph delivery["Delivery Phase"]
        direction TB
        SM["SM<br/><i>Scrum Master</i>"] -->|produces| STORIES["Stories<br/><i>Epics & Tasks</i>"]
    end

    subgraph impl["Implementation Phase"]
        direction TB
        DE["DE<br/><i>Data Engineer</i>"] -->|builds| PIPELINE["Pipeline<br/><i>Data Pipeline</i>"]
        DQA["DQA<br/><i>DQ Analyst</i>"] -->|tests| PIPELINE
        DEVOPS["DevOps<br/><i>DevOps Engineer</i>"] -->|deploys| PIPELINE
        DVE["DVE<br/><i>Data Viz Engineer</i>"] -->|visualizes| DASH["Dashboards<br/><i>Reports & Metrics</i>"]
    end

    DRD -->|feeds| ARCH
