%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '16px', 'fontFamily': 'arial'}}}%%
flowchart TD
    A[Input & Context] --> B[Goal & Planning]
    B --> C[Reasoning Engine]
    C --> D[Tool & Action Interface]
    D --> E[Execution & Logging]
    E --> F[Memory & State Management]
    F --> G[Feedback & Loop Control]
    G --> H[Output & Communication]
    H --> I[User / System / Next Step]

    %% Optional: Add feedback loop for error handling
    G -->|If Error| D
    G -->|If Success| I
    G -->|If Adaptation Needed| C

    %% Style for visual clarity
    classDef input fill:#f0f8ff,stroke:#2c3e50,stroke-width:2px
    classDef plan fill:#e6f7ff,stroke:#2c3e50,stroke-width:2px
    classDef reason fill:#d4edda,stroke:#155724,stroke-width:2px
    classDef tool fill:#ffe6e6,stroke:#c12e2a,stroke-width:2px
    classDef exec fill:#fff3cd,stroke:#856404,stroke-width:2px
    classDef memory fill:#f8f9fa,stroke:#5c6bc0,stroke-width:2px
    classDef feedback fill:#d1e7dd,stroke:#2e7d32,stroke-width:2px
    classDef output fill:#e3f2fd,stroke:#1976d2,stroke-width:2px

    class A input
    class B plan
    class C reason
    class D tool
    class E exec
    class F memory
    class G feedback
    class H output
