%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '16px', 'fontFamily': 'arial'}}}%%
flowchart LR
    subgraph Module["Agent Module"]
        direction TB
        INPUTS["inputs/<br/><i>Business requests, source docs,<br/>catalogs, stakeholder notes</i>"]
        TOOLS["tools/<br/><i>External utilities, scripts,<br/>validators</i>"]
        SKILLS["skills/<br/><i>Defined capabilities<br/>(create, update, validate)</i>"]
        HOOKS["hooks/<br/><i>Event-driven automation<br/>(pre/post actions)</i>"]
    end

    CMD["Command<br/><i>User or orchestrator<br/>triggers agent</i>"]

    subgraph Orch["Coding Agent Runtime"]
        direction TB
        INVOKE[Invoke Skill]
        EXEC[Execute]
        OUTPUT[Output]
        REVIEW{Human Review}
    end

    INPUTS --> INVOKE
    TOOLS --> EXEC
    SKILLS --> INVOKE
    HOOKS --> EXEC

    CMD --> INVOKE
    INVOKE --> EXEC --> OUTPUT --> REVIEW
    REVIEW -->|Approved| NEXT[Next Agent]
    REVIEW -->|Feedback| EXEC

    style INPUTS fill:#4ecdc4,stroke:#333,stroke-width:2px
    style TOOLS fill:#ffd93d,stroke:#333,stroke-width:2px
    style SKILLS fill:#6bcb77,stroke:#333,stroke-width:2px
    style HOOKS fill:#ff6b6b,stroke:#333,stroke-width:2px
    style CMD fill:#b8d4e3,stroke:#333,stroke-width:2px
    style INVOKE fill:#e8e8e8,stroke:#333,stroke-width:2px
    style EXEC fill:#e8e8e8,stroke:#333,stroke-width:2px
    style OUTPUT fill:#dcedc8,stroke:#333,stroke-width:2px
    style REVIEW fill:#ffd700,stroke:#333,stroke-width:2px
    style NEXT fill:#a5d4ff,stroke:#333,stroke-width:2px
    style Module fill:#e8f4f8,stroke:#2196F3,stroke-width:2px
    style Orch fill:#fff8e1,stroke:#FF9800,stroke-width:2px
