%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '16px', 'fontFamily': 'arial'}}}%%
flowchart LR
    A["Push / PR"]
    B["lint<br/>ruff · format check"]
    C["unit tests<br/>bronze · silver · gold"]
    D["package<br/>build wheel"]
    E["integration test"]
    F{"successful?"}
    G["deploy<br/>publish artifacts"]
    H["report status on PR"]

    A --> B --> C --> D --> E --> F
    F -->|yes| G
    F -->|no| H

    classDef trigger fill:#E6EEF7,stroke:#4A72A8,color:#16314A,stroke-width:2px;
    classDef step fill:#EDF7E8,stroke:#7AA85A,color:#2A4A10,stroke-width:2px;
    classDef gate fill:#F7EFE0,stroke:#B08A40,color:#4A3810,stroke-width:2px;
    classDef deploy fill:#E8E8F4,stroke:#6A6AB0,color:#1A1A4A,stroke-width:2px;
    classDef report fill:#F7E8E8,stroke:#B05A5A,color:#4A1010,stroke-width:2px;
    class A trigger;
    class B,C,D,E step;
    class F gate;
    class G deploy;
    class H report;
